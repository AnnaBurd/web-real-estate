---
import { CONTACT, zaloLink } from "../../config/site";
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="VietLand — trang chủ">
      <span class="mark">V</span>
      <span class="word">Viet<span class="accent">Land</span></span>
    </a>

    <nav class="nav" aria-label="Chính">
      <a href="/#opportunities">Đất đang bán</a>
      <a href="/#process">Quy trình</a>
    </nav>

    <div class="actions">
      <a href={CONTACT.tel} class="phone">{CONTACT.phoneDisplay}</a>
      <a
        href={zaloLink("Chào anh/chị, em muốn nhận giá và pháp lý một lô đất.")}
        target="_blank"
        rel="noopener"
        class="cta">Nhận giá qua Zalo</a
      >
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding-block: 0.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .mark {
    display: grid;
    place-items: center;
    height: 2rem;
    width: 2rem;
    border-radius: var(--radius-md);
    background: var(--forest);
    color: var(--forest-foreground);
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: 1.125rem;
    line-height: 1;
  }
  .word {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .accent {
    color: var(--clay);
  }
  .nav {
    display: none;
    justify-content: center;
    gap: 1.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--muted-foreground);
  }
  .nav a:hover {
    color: var(--foreground);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .phone {
    display: none;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--muted-foreground);
  }
  .phone:hover {
    color: var(--foreground);
  }
  .cta {
    border-radius: var(--radius-pill);
    background: var(--clay);
    color: var(--clay-foreground);
    padding: 0.5rem 1rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    transition: opacity 0.15s;
  }
  .cta:hover {
    opacity: 0.9;
  }
  @media (min-width: 640px) {
    .phone {
      display: inline;
    }
  }
  @media (min-width: 768px) {
    .nav {
      display: flex;
    }
  }
</style>
