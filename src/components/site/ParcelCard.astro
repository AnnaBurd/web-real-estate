---
/**
 * Parcel card — owner-direct listing tile for the homepage grid.
 * Ported from the Lovable redesign (components/site/ParcelCard) to Astro +
 * pure CSS, reading from the markdown content collection. VI-first copy.
 */
import { Image } from "astro:assets";
import Icon from "../ui/Icon.astro";
import { type Parcel, formatArea } from "../../lib/parcels";
import { zaloLink } from "../../config/site";

interface Props {
  parcel: Parcel;
}
const { parcel } = Astro.props;
const p = parcel.data;

const title = p.opportunityTitle ?? p.title;
const cover = p.images[0];

const VERIFICATION: Record<
  Parcel["data"]["verification"],
  { label: string; cls: string }
> = {
  "red-book": { label: "Sổ đỏ đã xác minh", cls: "redbook" },
  pending: { label: "Pháp lý đang hoàn thiện", cls: "clay" },
  planning: { label: "Đất quy hoạch", cls: "forest" },
};
const badge = VERIFICATION[p.verification];
---

<article class="card">
  <a class="media" href={`/parcels/${parcel.id}`} aria-label={title}>
    {
      cover && (
        <Image
          src={cover.src}
          alt={cover.alt ?? title}
          width={800}
          height={600}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
          loading="lazy"
        />
      )
    }
    <div class="badges">
      <span class={`badge ${badge.cls}`}>{badge.label}</span>
      {p.tag && <span class="badge paper">{p.tag}</span>}
    </div>
    <div class="scrim"></div>
  </a>

  <div class="body">
    <div>
      <h3 class="title">{title}</h3>
      <div class="loc">
        <Icon name="location" size={13} />
        <span>{p.location}</span>
      </div>
    </div>

    <div class="hairline"></div>

    <dl class="facts">
      <div>
        <dt>Diện tích</dt>
        <dd>{formatArea(p.area)}</dd>
      </div>
      <div>
        <dt>Khoảng giá</dt>
        <dd>
          {p.priceRange}
          {p.negotiable && <span class="neg"> · thương lượng</span>}
        </dd>
      </div>
    </dl>

    {
      p.sellingPoints.length > 0 && (
        <ul class="points">
          {p.sellingPoints.slice(0, 3).map((w) => (
            <li>
              <span class="dot" />
              <span>{w}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      p.urgency && (
        <div class="urgency">
          <Icon name="shield-tick" size={13} />
          {p.urgency}
        </div>
      )
    }

    <a
      class="cta"
      href={zaloLink(p.zaloMessage)}
      target="_blank"
      rel="noopener"
    >
      <Icon name="message" size={16} />
      Nhận giá &amp; pháp lý qua Zalo
    </a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--border);
    background: var(--paper);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .card:hover {
    border-color: color-mix(in oklab, var(--forest) 40%, transparent);
    box-shadow: var(--shadow-lg);
  }

  .media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--muted);
  }
  .media :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .card:hover .media :global(img) {
    transform: scale(1.05);
  }
  .scrim {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 33%;
    background: linear-gradient(
      to top,
      oklch(0% 0 0 / 0.55),
      transparent
    );
  }

  .badges {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    z-index: 1;
  }
  .badge {
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.625rem;
    font-size: 0.625rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .badge.redbook {
    background: var(--redbook);
    color: var(--redbook-foreground);
  }
  .badge.clay {
    background: var(--clay);
    color: var(--clay-foreground);
  }
  .badge.forest {
    background: var(--forest);
    color: var(--forest-foreground);
  }
  .badge.paper {
    background: color-mix(in oklab, var(--paper) 90%, transparent);
    color: var(--foreground);
    backdrop-filter: blur(4px);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }
  .loc {
    margin-top: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-xs);
    line-height: var(--leading-tight);
    color: var(--muted-foreground);
  }
  .loc :global(svg) {
    flex-shrink: 0;
  }

  .hairline {
    border-top: 1px solid color-mix(in oklab, var(--border) 70%, transparent);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .facts dt {
    font-size: 0.625rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--muted-foreground);
  }
  .facts dd {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }
  .neg {
    font-size: 0.625rem;
    font-weight: var(--weight-medium);
    color: var(--clay);
  }

  .points {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: color-mix(in oklab, var(--foreground) 80%, transparent);
  }
  .points li {
    display: flex;
    gap: 0.5rem;
  }
  .dot {
    margin-top: 7px;
    height: 4px;
    width: 4px;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    background: var(--clay);
  }

  .urgency {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    align-self: flex-start;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--redbook) 10%, transparent);
    padding: 0.25rem 0.625rem;
    font-size: 0.625rem;
    font-weight: var(--weight-semibold);
    color: var(--redbook);
  }

  .cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--clay);
    padding: 0.75rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--clay-foreground);
    transition: opacity 0.15s;
  }
  .cta:hover {
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: reduce) {
    .media :global(img),
    .card:hover .media :global(img) {
      transition: none;
      transform: none;
    }
  }
</style>
