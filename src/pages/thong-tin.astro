---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import { CONTACT, zaloLink, FEATURES } from "../config/site";
import landPhoto from "../assets/parcels/3-3-sao-hoa-long/01.jpg";
import redBookPhoto from "../assets/parcels/3-3-sao-hoa-long/04.jpg";

const teamPoints: { icon: string; t: string; d: string }[] = [
  {
    icon: "location",
    t: "Sinh sống và hoạt động tại địa phương",
    d: "Chúng tôi hoạt động tại khu vực có đất bán, nên có thể hỗ trợ xem thực địa và giấy tờ nhanh hơn.",
  },
  {
    icon: "people",
    t: "Bạn nói chuyện với chính chủ",
    d: "Bạn trao đổi với người nắm hồ sơ, không phải qua nhiều lớp nhân viên trung gian.",
  },
  {
    icon: "document",
    t: "Gắn bó với vùng đất từ 2013",
    d: "Hơn mười năm mua, giữ và chọn lọc bán lại đất của gia đình trong vùng. Có thể cung cấp thêm thông tin khi trao đổi nghiêm túc.",
  },
];

const commitments = [
  "Tình trạng pháp lý được nêu rõ trên từng tin đăng",
  "Điểm cần kiểm tra được ghi riêng để người mua tự đối chiếu",
  "Khoảng giá hiển thị là mức tham khảo để người mua cân nhắc trước khi liên hệ",
  "Khuyến khích xem hồ sơ trước khi đi thực địa",
];

const directStats: { label: string; value: string }[] = [
  { label: "Hoa hồng môi giới điển hình", value: "2–5%" },
  { label: "Phí môi giới trả cho chúng tôi", value: "0đ" },
  { label: "Thương lượng", value: "Trực tiếp với chủ đất" },
];
---

<BaseLayout
  title="Thông tin — Chủ đất bán trực tiếp | VietLand"
  description="Chủ đất cá nhân bán trực tiếp tại khu vực phía Nam. Một gia đình gắn bó với vùng đất từ 2013, cung cấp thông tin rõ ràng để người mua kiểm tra trước khi xem đất."
  contactMessage="Chào anh/chị, em xem trang thông tin và có vài câu hỏi về một lô đất."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-col">
        <div class="eyebrow">Thông tin</div>
        <h1>Chủ đất bán trực tiếp.<br /><span class="accent">Không qua môi giới.</span></h1>
        <p class="lede">
          Mỗi lô đất trên trang này đều do chúng tôi sở hữu hoặc đồng sở hữu.
          Chúng tôi rao bán trực tiếp vì tin rằng người mua đất tại Việt Nam
          nên được xem thông tin rõ ràng trước khi đi thực địa, không phải qua
          nhiều lớp trung gian.
        </p>
      </div>
    </div>
  </section>

  <!-- Ownership proof + team -->
  <section class="band">
    <div class="container two">
      <div class="media">
        <Image
          src={landPhoto}
          alt="Mảnh đất thực tế tại Hòa Long, Bà Rịa (nay thuộc TP.HCM)"
          widths={[512, 1024]}
          sizes="(min-width: 1024px) 600px, 100vw"
          loading="lazy"
        />
        <div class="caption">Đất thực tế · Hòa Long, Bà Rịa</div>
      </div>
      <div>
        <h2>Ba người trong một gia đình. Một vùng đất. Hơn mười năm.</h2>
        <p class="muted">
          Chúng tôi là ba người trong cùng một gia đình, hoạt động tại khu vực
          Bà Rịa – Vũng Tàu (nay thuộc TP.HCM). Lô đất đầu tiên được mua từ năm
          2013, và từ đó đến nay chúng tôi liên tục mua, giữ và chọn lọc bán lại
          đất của chính mình trong vùng.
        </p>
        <p class="muted">
          Trong thời gian đó, chúng tôi đã xây dựng quan hệ trực tiếp với công
          chứng, văn phòng địa chính và cán bộ xã. Điều này quan trọng vì ở Việt
          Nam, giao dịch đất phụ thuộc nhiều vào việc đối chiếu hồ sơ, quy hoạch
          và giấy tờ tại địa phương.
        </p>
        <ul class="points">
          {
            teamPoints.map(({ icon, t, d }) => (
              <li>
                <Icon name={icon} size={20} class="ic" />
                <div>
                  <div class="t">{t}</div>
                  <div class="d">{d}</div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Why listings are real -->
  <section class="band paper">
    <div class="container two flip">
      <div>
        <div class="eyebrow">Minh bạch</div>
        <h2>Vì sao thông tin trên trang này đáng kiểm tra</h2>
        <div class="stack muted">
          <p>
            Nhiều tin rao bán đất được truyền qua nhiều kênh trước khi đến người
            mua, khiến thông tin về giá, giấy tờ và vị trí dễ bị sai lệch.
          </p>
          <p>
            Với các lô trên trang này, chúng tôi chỉ đăng những lô gia đình sở
            hữu trực tiếp hoặc có quyền làm việc rõ ràng theo hồ sơ đồng sở hữu.
            Người mua có thể yêu cầu giấy tờ để tự kiểm tra trước khi xem đất.
          </p>
          <p>
            Trước mọi buổi xem đất, chúng tôi gửi ảnh sổ đỏ (đã che thông tin cá
            nhân), bản đồ địa chính hiện hành và mức giá sàn. Nếu một lô có
            hạn chế quy hoạch, hồ sơ đang hoàn thiện hay lưu ý pháp lý, chúng tôi
            ghi rõ trong tin đăng công khai.
          </p>
        </div>

        <div class="commit">
          <div class="commit-head">
            <Icon name="eye" size={20} class="ic" />
            <div class="t">Cam kết minh bạch</div>
          </div>
          <ul>
            {
              commitments.map((c) => (
                <li>
                  <span class="dash">—</span>
                  <span>{c}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="media">
        <Image
          src={redBookPhoto}
          alt="Sổ đỏ một lô đất của chúng tôi, thông tin cá nhân đã che"
          widths={[512, 1024]}
          sizes="(min-width: 1024px) 600px, 100vw"
          loading="lazy"
        />
        <div class="caption">Xác minh sổ đỏ · cung cấp khi có yêu cầu</div>
      </div>
    </div>
  </section>

  <!-- Why we sell directly -->
  <section class="band forest">
    <div class="container">
      <div class="forest-col">
        <div class="eyebrow">Bán trực tiếp</div>
        <h2>Vì sao chúng tôi không dùng môi giới</h2>
        <div class="stack">
          <p>
            Môi giới đất ở Việt Nam thường thu 2–5% hoa hồng, do bên bán trả.
            Khoản này thường được tính vào phương án giá, dù người mua không
            luôn nhìn thấy thành phần chi phí đó.
          </p>
          <p>
            Chúng tôi bán trực tiếp để quá trình trao đổi đơn giản hơn. Bạn nêu
            ngân sách và điều kiện mua, chúng tôi phản hồi mức giá sàn cùng phần
            có thể thương lượng.
          </p>
          <p>
            Điều này cũng giúp chúng tôi hành động nhanh và linh hoạt: làm việc
            trực tiếp với người mua, không phải chờ qua nhiều khâu trung gian.
          </p>
        </div>
        <div class="forest-stats">
          {
            directStats.map((s) => (
              <div class="fs">
                <div class="fs-label">{s.label}</div>
                <div class="fs-value">{s.value}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta-band">
    <div class="container cta-inner">
      <Icon name="shield-tick" size={32} class="cta-ic" />
      <h2>Vẫn còn băn khoăn? Điều đó là bình thường.</h2>
      <p>
        {
          FEATURES.hideDirectContact
            ? "Cách tốt nhất để kiểm tra thông tin là trao đổi trực tiếp. Để lại thông tin, chúng tôi sẽ liên hệ lại để gửi hồ sơ, trả lời câu hỏi về từng lô và hẹn lịch xem đất nếu phù hợp."
            : "Cách tốt nhất để kiểm tra thông tin là trao đổi trực tiếp qua Zalo. Bạn có thể hỏi hồ sơ, giá, lý do bán và lịch xem đất của từng lô."
        }
      </p>
      <div class="cta-actions">
        {
          FEATURES.hideDirectContact ? (
            <button
              class="cta-zalo"
              type="button"
              data-lead-open
              data-lead-context="Chào anh/chị, em xem trang web và có vài câu hỏi trước khi đi xem đất."
            >
              Yêu cầu gọi lại
            </button>
          ) : (
            <>
              <a
                class="cta-zalo"
                href={zaloLink(
                  "Chào anh/chị, em xem trang web và có vài câu hỏi trước khi đi xem đất.",
                )}
                target="_blank"
                rel="noopener"
              >
                Hỏi qua Zalo
              </a>
              <a class="cta-phone" href={CONTACT.tel}>
                <Icon name="call" size={16} />
                {CONTACT.phoneDisplay}
              </a>
            </>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    font-size: 0.6875rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--clay);
  }

  /* Hero */
  .hero {
    border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    background: var(--cream);
    padding-block: 4rem;
  }
  .hero-col {
    max-width: 48rem;
  }
  .hero h1 {
    margin-top: 0.75rem;
    font-size: var(--text-6xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }
  .accent {
    color: var(--clay);
  }
  .lede {
    margin-top: 1.25rem;
    max-width: 36rem;
    font-size: var(--text-lg);
    color: var(--muted-foreground);
  }

  /* Generic bands */
  .band {
    border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    padding-block: 4rem;
  }
  .band.paper {
    background: var(--paper);
  }
  .two {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-2xl);
  }
  .media :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  .caption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--paper) 95%, transparent);
    padding: 0.375rem 0.75rem;
    font-size: 0.625rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--foreground);
    backdrop-filter: blur(4px);
  }

  h2 {
    font-size: var(--text-4xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }
  .band h2 {
    margin-top: 0.5rem;
  }
  .muted {
    color: var(--muted-foreground);
  }
  .band p {
    margin-top: 1rem;
  }
  .stack p {
    margin-top: 1.25rem;
  }
  .stack p:first-child {
    margin-top: 1.5rem;
  }

  .points {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }
  .points li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .points :global(.ic) {
    margin-top: 2px;
    flex-shrink: 0;
    color: var(--clay);
  }
  .points .t {
    font-weight: var(--weight-semibold);
  }
  .points .d {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }

  .commit {
    margin-top: 2rem;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--border);
    background: var(--background);
    padding: 1.5rem;
  }
  .commit-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .commit-head :global(.ic) {
    color: var(--clay);
  }
  .commit-head .t {
    font-weight: var(--weight-semibold);
  }
  .commit ul {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
  .commit li {
    display: flex;
    gap: 0.5rem;
  }
  .dash {
    color: var(--clay);
  }

  /* Forest band */
  .forest {
    background: var(--forest);
    color: var(--forest-foreground);
  }
  .forest-col {
    max-width: 48rem;
  }
  .forest h2 {
    color: var(--forest-foreground);
  }
  .forest .stack {
    color: color-mix(in oklab, var(--forest-foreground) 80%, transparent);
  }
  .forest-stats {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  .fs {
    border-radius: var(--radius-2xl);
    border: 1px solid color-mix(in oklab, var(--forest-foreground) 15%, transparent);
    background: color-mix(in oklab, var(--forest-foreground) 5%, transparent);
    padding: 1.25rem;
  }
  .fs-label {
    font-size: 0.625rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: color-mix(in oklab, var(--forest-foreground) 60%, transparent);
  }
  .fs-value {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  /* Final CTA */
  .cta-band {
    background: var(--clay);
    color: var(--clay-foreground);
    padding-block: 4rem;
  }
  .cta-inner {
    max-width: 56rem;
    text-align: center;
  }
  .cta-inner :global(.cta-ic) {
    margin-inline: auto;
    color: color-mix(in oklab, var(--clay-foreground) 80%, transparent);
  }
  .cta-band h2 {
    margin-top: 1rem;
    font-size: var(--text-5xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tighter);
    color: var(--clay-foreground);
  }
  .cta-band p {
    margin-inline: auto;
    margin-top: 1.25rem;
    max-width: 36rem;
    font-size: var(--text-lg);
    color: color-mix(in oklab, var(--clay-foreground) 85%, transparent);
  }
  .cta-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .cta-zalo {
    border-radius: var(--radius-pill);
    background: var(--ink);
    padding: 0.875rem 1.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--paper);
    transition: opacity 0.15s;
  }
  .cta-zalo:hover {
    opacity: 0.9;
  }
  .cta-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in oklab, var(--clay-foreground) 40%, transparent);
    padding: 0.875rem 1.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--clay-foreground);
    transition: background 0.15s;
  }
  .cta-phone:hover {
    background: color-mix(in oklab, var(--clay-foreground) 10%, transparent);
  }

  @media (min-width: 640px) {
    .hero {
      padding-block: 6rem;
    }
    .band,
    .cta-band {
      padding-block: 6rem;
    }
    .forest-stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .two {
      grid-template-columns: 1fr 1fr;
    }
    .two.flip {
      grid-template-columns: 1.1fr 1fr;
    }
  }
</style>
