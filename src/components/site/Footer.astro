---
import { CONTACT } from "../../config/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container top">
    <div>
      <div class="word">Viet<span class="accent">Land</span></div>
      <p class="tagline">
        Bán đất chính chủ khắp khu vực phía Nam. Lô đất đã xác minh, pháp lý minh
        bạch, không qua trung gian.
      </p>
    </div>
    <div class="info">
      <div class="label">Hotline</div>
      <div class="muted">{CONTACT.phoneDisplay}</div>
      <div class="label">Khu vực</div>
      <div class="muted">Bà Rịa – Vũng Tàu, Việt Nam</div>
      <div class="label">Công ty</div>
      <div><a href="/thong-tin" class="link">Về chúng tôi</a></div>
    </div>
  </div>
  <div class="copy">© {year} VietLand. Chỉ bán trực tiếp từ chính chủ.</div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    background: var(--cream);
  }
  .top {
    display: grid;
    gap: 1.5rem;
    padding-block: 2.5rem;
  }
  .word {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .accent {
    color: var(--clay);
  }
  .tagline {
    margin-top: 0.5rem;
    max-width: 28rem;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
  .info {
    font-size: var(--text-sm);
  }
  .label {
    font-weight: var(--weight-semibold);
    margin-top: 0.75rem;
  }
  .label:first-child {
    margin-top: 0;
  }
  .muted {
    margin-top: 0.25rem;
    color: var(--muted-foreground);
  }
  .link {
    margin-top: 0.25rem;
    color: var(--muted-foreground);
  }
  .link:hover {
    color: var(--foreground);
  }
  .copy {
    border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    padding-block: 1rem;
    text-align: center;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
  }
  @media (min-width: 640px) {
    .top {
      grid-template-columns: 1fr auto;
    }
  }
</style>
