# --- Lead form / direct-contact flag (2026 legal hold) ---

# By default the site HIDES all direct phone + Zalo links and routes every
# lead through the call-back / write-back form. To restore the old phone + Zalo
# behavior everywhere, uncomment the next line:
# PUBLIC_SHOW_DIRECT_CONTACT="true"

# Where the form POSTs submissions. Defaults to the bundled function at
# /api/lead. Point this at any form service instead (e.g. a Vietnamese one)
# without touching the front end. Set to "" to skip POST and use mailto only.
# PUBLIC_LEAD_ENDPOINT="/api/lead"

# mailto fallback address — used when a POST fails or no endpoint is set.
PUBLIC_LEAD_EMAIL="lienhe@viet-land.vn"

# --- Server-side, set in the Netlify UI (never exposed to the browser) ---
# URL the lead function forwards submissions to as a JSON POST. Point at your
# chosen delivery (a Vietnamese email/SMS service, Telegram bot, no-code
# webhook, your own backend). If unset, the form falls back to mailto.
# LEAD_WEBHOOK_URL=""
