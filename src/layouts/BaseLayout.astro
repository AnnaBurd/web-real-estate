---
/**
 * v2 base layout — pure CSS, Vietnamese-first. Includes the shared chrome
 * (Header, Footer, sticky Zalo/phone contact) so pages only render content.
 */
import "../styles/app.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import StickyContact from "../components/site/StickyContact.astro";
import LeadDialog from "../components/site/LeadDialog.astro";
import { FEATURES } from "../config/site";

interface Props {
  title: string;
  description?: string;
  /** Open Graph image URL (absolute). */
  ogImage?: string;
  /** Alt text for the OG image. */
  ogImageAlt?: string;
  /** Pre-filled message for the sticky Zalo button. */
  contactMessage?: string;
  /** Hide the shared chrome (e.g. for error pages). */
  bare?: boolean;
  /** JSON-LD structured data — a single node or an array of nodes. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  contactMessage,
  bare = false,
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const SITE_NAME = "VietLand";
// Default social-share image, used when a page doesn't supply its own.
const ogImageUrl = new URL(
  ogImage ?? "/og-default.jpg",
  Astro.site ?? Astro.url,
).href;
const ogImageAltText = ogImageAlt ?? title;

const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#153c25" />

    <!-- Preload the display-font subsets used by the LCP headings -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxC9TeA.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxCBTeO-U.woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAltText} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    {
      jsonLdItems.map((item) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
  </head>

  <body>
    {bare ? (
      <slot />
    ) : (
      <>
        <Header />
        <main>
          <slot />
        </main>
        <Footer />
        <StickyContact message={contactMessage} />
        {FEATURES.hideDirectContact && <LeadDialog defaultContext={contactMessage} />}
      </>
    )}
  </body>
</html>
