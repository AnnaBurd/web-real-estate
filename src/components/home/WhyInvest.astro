---
/**
 * "Why now" — four reasons the southern land market is repricing.
 * Static editorial content ported from the Lovable redesign, translated to VI.
 */
import Icon from "../ui/Icon.astro";

const items = [
  {
    icon: "trend-up",
    title: "Hạ tầng đang mở rộng",
    body: "Sân bay Long Thành, cao tốc Biên Hòa–Vũng Tàu và các tuyến ven biển đang rút ngắn thời gian di chuyển trong khu vực phía Nam.",
  },
  {
    icon: "sparkle",
    title: "Quỹ đất khan hiếm",
    body: "Đất mặt tiền, đất vườn quy mô lớn và đất gần biển trong bán kính di chuyển từ TP.HCM ngày càng khó tìm, nhất là lô có hồ sơ rõ ràng.",
  },
  {
    icon: "judge",
    title: "Pháp lý trình bày rõ",
    body: "Mỗi lô đều hiển thị tình trạng pháp lý công khai: có sổ đỏ, hồ sơ đang hoàn thiện hoặc cần kiểm tra quy hoạch. Các điểm cần lưu ý được ghi rõ để người mua tự kiểm chứng.",
  },
  {
    icon: "exchange",
    title: "Thương lượng trực tiếp",
    body: "Bạn trao đổi giá, tiến độ và điều kiện mua trực tiếp với chủ đất. Không qua nhiều lớp trung gian làm chậm thông tin hoặc đội chi phí.",
  },
] as const;
---

<section class="why">
  <div class="container">
    <div class="head">
      <div class="eyebrow">Vì sao nên xem lúc này</div>
      <h2>
        Một số khu vực phía Nam đang thay đổi nhanh nhờ hạ tầng, dòng dân cư và quỹ đất lớn ngày càng ít.
      </h2>
    </div>
    <div class="grid">
      {
        items.map(({ icon, title, body }) => (
          <div class="cell">
            <Icon name={icon} size={28} class="ic" />
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why {
    border-top: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    background: var(--background);
    padding-block: 5rem;
  }
  .head {
    max-width: 36rem;
  }
  .eyebrow {
    font-size: 0.6875rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--clay);
  }
  h2 {
    margin-top: 0.5rem;
    font-size: var(--text-4xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .grid {
    margin-top: 3rem;
    display: grid;
    gap: 1px;
    overflow: hidden;
    border-radius: var(--radius-3xl);
    border: 1px solid var(--border);
    background: var(--border);
    grid-template-columns: 1fr;
  }
  .cell {
    background: var(--paper);
    padding: 2rem;
  }
  .cell :global(.ic) {
    color: var(--clay);
  }
  .cell h3 {
    margin-top: 1.25rem;
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }
  .cell p {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted-foreground);
  }

  @media (min-width: 640px) {
    .why {
      padding-block: 7rem;
    }
    h2 {
      font-size: var(--text-5xl);
    }
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
