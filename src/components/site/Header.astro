---
import { CONTACT, zaloLink, FEATURES } from "../../config/site";
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="VietLand — trang chủ">
      <svg class="mark" viewBox="0 0 230 205" fill="none" aria-hidden="true">
        <path d="M218 2 L12.5 2 Q2.5 2 7.3 10.77 L20.7 35.23 Q25.5 44 35.5 44 L150 44 Q160 44 155.06 52.69 L98.44 152.31 Q93.5 161 98.51 169.66 L112.49 193.84 Q117.5 202.5 122.33 193.74 L223.17 10.76 Q228 2 218 2 Z" fill="var(--forest)" />
        <path d="M98 71.5 L48 71.5 Q42 71.5 44.95 76.72 L69.55 120.28 Q72.5 125.5 75.52 120.32 L100.98 76.68 Q104 71.5 98 71.5 Z" fill="var(--clay)" />
      </svg>
      <span class="word">Viet<span class="accent">Land</span></span>
    </a>

    <nav class="nav" aria-label="Chính">
      <a href="/#opportunities">Đất đang bán</a>
      <a href="/#process">Quy trình</a>
    </nav>

    <div class="actions">
      {
        FEATURES.hideDirectContact ? (
          <button
            type="button"
            class="cta"
            data-lead-open
            data-lead-context="Chào anh/chị, em muốn nhận giá và pháp lý một lô đất."
          >
            Nhận giá
          </button>
        ) : (
          <>
            <a href={CONTACT.tel} class="phone">
              {CONTACT.phoneDisplay}
            </a>
            <a
              href={zaloLink(
                "Chào anh/chị, em muốn nhận giá và pháp lý một lô đất.",
              )}
              target="_blank"
              rel="noopener"
              class="cta"
            >
              Nhận giá qua Zalo
            </a>
          </>
        )
      }
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding-block: 0.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .mark {
    height: 1.5rem;
    width: auto;
    flex: none;
  }
  .word {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .accent {
    color: var(--clay);
  }
  .nav {
    display: none;
    justify-content: center;
    gap: 1.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--muted-foreground);
  }
  .nav a:hover {
    color: var(--foreground);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .phone {
    display: none;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--muted-foreground);
  }
  .phone:hover {
    color: var(--foreground);
  }
  .cta {
    border-radius: var(--radius-pill);
    background: var(--clay);
    color: var(--clay-foreground);
    padding: 0.5rem 1rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    transition: opacity 0.15s;
  }
  .cta:hover {
    opacity: 0.9;
  }
  @media (min-width: 640px) {
    .phone {
      display: inline;
    }
  }
  @media (min-width: 768px) {
    .nav {
      display: flex;
    }
  }
</style>
